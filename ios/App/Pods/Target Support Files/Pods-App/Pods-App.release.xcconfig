ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorBiometricAuth" "${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorSecureStorage" "${PODS_CONFIGURATION_BUILD_DIR}/Capacitor" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBrowser" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCamera" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorHaptics" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorKeyboard" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorLocalNotifications" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPreferences" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPushNotifications" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorStatusBar" "${PODS_CONFIGURATION_BUILD_DIR}/KeychainSwift"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorBiometricAuth/AparajitaCapacitorBiometricAuth.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorSecureStorage/AparajitaCapacitorSecureStorage.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Capacitor/Capacitor.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp/CapacitorApp.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBrowser/CapacitorBrowser.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCamera/CapacitorCamera.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova/Cordova.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorHaptics/CapacitorHaptics.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorKeyboard/CapacitorKeyboard.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorLocalNotifications/CapacitorLocalNotifications.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPreferences/CapacitorPreferences.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPushNotifications/CapacitorPushNotifications.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorStatusBar/CapacitorStatusBar.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/KeychainSwift/KeychainSwift.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -isystem "${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorBiometricAuth/AparajitaCapacitorBiometricAuth.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorSecureStorage/AparajitaCapacitorSecureStorage.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Capacitor/Capacitor.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp/CapacitorApp.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBrowser/CapacitorBrowser.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCamera/CapacitorCamera.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova/Cordova.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorHaptics/CapacitorHaptics.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorKeyboard/CapacitorKeyboard.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorLocalNotifications/CapacitorLocalNotifications.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPreferences/CapacitorPreferences.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPushNotifications/CapacitorPushNotifications.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorStatusBar/CapacitorStatusBar.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/KeychainSwift/KeychainSwift.framework/Headers" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorBiometricAuth" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorSecureStorage" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Capacitor" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBrowser" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCamera" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorHaptics" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorKeyboard" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorLocalNotifications" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPreferences" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPushNotifications" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/CapacitorStatusBar" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/KeychainSwift"
OTHER_LDFLAGS = $(inherited) -framework "AparajitaCapacitorBiometricAuth" -framework "AparajitaCapacitorSecureStorage" -framework "Capacitor" -framework "CapacitorApp" -framework "CapacitorBrowser" -framework "CapacitorCamera" -framework "CapacitorHaptics" -framework "CapacitorKeyboard" -framework "CapacitorLocalNotifications" -framework "CapacitorPreferences" -framework "CapacitorPushNotifications" -framework "CapacitorStatusBar" -framework "Cordova" -framework "KeychainSwift" -framework "WebKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorBiometricAuth" "-F${PODS_CONFIGURATION_BUILD_DIR}/AparajitaCapacitorSecureStorage" "-F${PODS_CONFIGURATION_BUILD_DIR}/Capacitor" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorApp" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorBrowser" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCamera" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorCordova" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorHaptics" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorKeyboard" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorLocalNotifications" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPreferences" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorPushNotifications" "-F${PODS_CONFIGURATION_BUILD_DIR}/CapacitorStatusBar" "-F${PODS_CONFIGURATION_BUILD_DIR}/KeychainSwift"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
