{
  "name": "rest-express",
  "version": "1.0.0",
  "description": "REST API with Express and TypeScript",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:unified": "NODE_ENV=production tsx watch server/index.ts",
    "migrate:fix-constraints": "node apply-migration.js",
    "migrate:campaign-leads": "node run-campaign-leads-migration.js",
    "build": "npm run build:render",
    "start": "NODE_ENV=production node dist/server/index.js",
    "clean": "rm -rf dist",
    "build:server": "tsc --project tsconfig.production.json --noEmitOnError false || echo 'Build completed with warnings'",
    "build:client": "vite build",
    "build:render": "npm run clean && prisma generate && npm run build:server && npm run build:client",
    "build:mobile": "npm run clean && npm run build:client",
    "postbuild": "mkdir -p dist/server/uploads && cp -r shared dist/",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install",
    "db:query": "tsx db-query.ts",
    "cap:build": "yarn build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "check-doctor-onboarding": "node check-doctor-onboarding-simple.js",
    "fix-doctor-onboarding": "node fix-doctor-onboarding-simple.js",
    "check-partner": "node check-partner.js",
    "create-partner": "node create-partner.js"
  },
