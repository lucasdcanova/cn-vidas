# ─────────────────────────────────────────────────────────────────────────────
# CN Vidas — Environment variable reference
#
# Copy to `.env` and fill in. Never commit `.env`.
# The repo's .gitignore explicitly blocks every common secret pattern.
# In production these live in Render (web), Xcode Cloud (iOS), Play Console
# (Android) — not in any committed file.
# ─────────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# Auth — JWT_SECRET MUST be set. There is no safe default.
JWT_SECRET=
ENCRYPTION_KEY=

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/cnvidas

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx

# Daily.co (video)
DAILY_API_KEY=

# OpenAI (medical record summarization)
OPENAI_API_KEY=

# Email (Nodemailer)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# AWS S3 (uploads, recordings)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_DISTRIBUTION_ID=

# Twilio (SMS / 2FA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# APNs (iOS push) — prefer Base64-encoded auth key over file path
APNS_AUTH_KEY_BASE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.cnvidas.app
# Optional fallback path-based auth (legacy)
APNS_AUTH_KEY_PATH=
APNS_KEY_PATH=
APNS_CERT_PATH=

# Apple Wallet (PassKit) — Base64-encoded so it can be set as a Render env var
APPLE_PASS_TYPE_ID=pass.com.cnvidas.membership
APPLE_TEAM_ID=
APPLE_PASS_KEY_PASSWORD=
WALLET_SIGNER_KEY_BASE=
WALLET_SIGNER_CERT_BASE=
WALLET_WWDR_BASE=

# Render / build flags
RENDER=
CI=
